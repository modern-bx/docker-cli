#!/usr/bin/env php
<?php

use DockerCli\Command\ConfigInitCommand;
use DockerCli\Command\DataApplyCommand;
use DockerCli\Command\DataDatabaseCreateCommand;
use DockerCli\Command\DataDatabaseDeleteCommand;
use DockerCli\Command\DataDbuserCreateCommand;
use DockerCli\Command\DataDbuserDeleteCommand;
use DockerCli\Command\DataDropCommand;
use DockerCli\Command\DataDumpCommand;
use DockerCli\Command\DataInitCommand;
use DockerCli\Command\DataWipeCommand;
use DockerCli\Command\MysqlDumpCommand;
use DockerCli\Command\MysqlLoadCommand;
use DockerCli\Command\MysqlBackupDeleteCommand;
use DockerCli\Command\PostgresDumpCommand;
use DockerCli\Command\PostgresLoadCommand;
use DockerCli\Command\PostgresBackupDeleteCommand;
use DockerCli\Command\ProjectUpCommand;
use DockerCli\Command\ProjectCloneCommand;
use DockerCli\Command\ConfigSeedCommand;
use DockerCli\Command\ProjectConfigGetCommand;
use DockerCli\Command\ProjectConfigSetCommand;
use DockerCli\Command\ProjectDownCommand;
use DockerCli\Command\ProjectListCommand;
use DockerCli\Command\ProjectUpdateCommand;
use DockerCli\Command\ProjectShowCommand;
use DockerCli\Command\ProjectWipeCommand;
use DockerCli\Command\SystemStartCommand;
use DockerCli\Command\SystemStopCommand;
use DockerCli\Command\SystemRestartCommand;
use DockerCli\Command\BitrixGetInstallerCommand;
use DockerCli\Command\ImageBuildCommand;
use DockerCli\Command\ImagePublishCommand;
use DockerCli\Command\PlayRunCommand;
use DockerCli\Command\PanelUpCommand;
use DockerCli\Command\PanelDownCommand;
use DockerCli\Command\PanelUserCreateCommand;
use DockerCli\Command\PanelUserDeleteCommand;
use DockerCli\Command\PanelPasswordRotateCommand;
use DockerCli\Command\PanelTokenRevokeCommand;
use DockerCli\Command\ProjectDisableCommand;
use DockerCli\Command\ProjectEnableCommand;
use DockerCli\Command\TaskRunCommand;
use DockerCli\Command\TaskListCommand;
use DockerCli\Command\TreeDumpCommand;
use DockerCli\Command\TreeLoadCommand;
use DockerCli\Command\TreeBackupDeleteCommand;
use DockerCli\Command\QueueStepCommand;
use DockerCli\Command\QueueStartCommand;
use DockerCli\Command\QueueStopCommand;
use DockerCli\Command\QueuePauseCommand;
use DockerCli\Command\QueueResumeCommand;
use DockerCli\Command\QueueItemCreateCommand;
use DockerCli\Command\QueueListCommand;
use DockerCli\Command\QueueItemDeleteCommand;
use DockerCli\Command\ShellBashCommand;
use DockerCli\Command\ShellRunCommand;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$separator = array_search('--', $argv, true);
$usesDefaultCommand = is_int($separator) && $separator > 0;
foreach ($usesDefaultCommand ? array_slice($argv, 1, $separator - 1) : [] as $argument) {
    if (!str_starts_with($argument, '-')) {
        $usesDefaultCommand = false;
        break;
    }
}
if ($usesDefaultCommand) {
    array_splice($argv, 1, 0, ['shell:run']);
    $_SERVER['argv'] = $argv;
}

$application = new Application('docker-cli', '0.1.0');
$application->add(new ConfigInitCommand());
$application->add(new ProjectUpCommand());
$application->add(new ProjectCloneCommand());
$application->add(new ConfigSeedCommand());
$application->add(new DataApplyCommand());
$application->add(new DataDatabaseCreateCommand());
$application->add(new DataDatabaseDeleteCommand());
$application->add(new DataDbuserCreateCommand());
$application->add(new DataDbuserDeleteCommand());
$application->add(new DataDropCommand());
$application->add(new DataDumpCommand());
$application->add(new DataInitCommand());
$application->add(new DataWipeCommand());
$application->add(new MysqlDumpCommand());
$application->add(new MysqlLoadCommand());
$application->add(new MysqlBackupDeleteCommand());
$application->add(new PostgresDumpCommand());
$application->add(new PostgresLoadCommand());
$application->add(new PostgresBackupDeleteCommand());
$application->add(new TreeDumpCommand());
$application->add(new TreeLoadCommand());
$application->add(new TreeBackupDeleteCommand());
$application->add(new SystemStartCommand());
$application->add(new SystemStopCommand());
$application->add(new ProjectConfigGetCommand());
$application->add(new ProjectConfigSetCommand());
$application->add(new SystemRestartCommand());
$application->add(new ProjectDownCommand());
$application->add(new ProjectListCommand());
$application->add(new ProjectUpdateCommand());
$application->add(new ProjectShowCommand());
$application->add(new ProjectWipeCommand());
$application->add(new ImageBuildCommand());
$application->add(new ImagePublishCommand());
$application->add(new PlayRunCommand());
$application->add(new BitrixGetInstallerCommand());
$application->add(new PanelUpCommand());
$application->add(new PanelDownCommand());
$application->add(new PanelUserCreateCommand());
$application->add(new PanelUserDeleteCommand());
$application->add(new PanelPasswordRotateCommand());
$application->add(new PanelTokenRevokeCommand());
$application->add(new ProjectEnableCommand());
$application->add(new ProjectDisableCommand());
$application->add(new TaskRunCommand());
$application->add(new TaskListCommand());
$application->add(new QueueStepCommand());
$application->add(new QueueStartCommand());
$application->add(new QueueStopCommand());
$application->add(new QueuePauseCommand());
$application->add(new QueueResumeCommand());
$application->add(new QueueItemCreateCommand());
$application->add(new QueueListCommand());
$application->add(new QueueItemDeleteCommand());
$application->add(new ShellBashCommand());
$application->add(new ShellRunCommand());
$application->setDefaultCommand('shell:run');
$application->run();
