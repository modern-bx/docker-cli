#!/usr/bin/env php
<?php

use DockerCli\Command\InitCommand;
use DockerCli\Command\UpCommand;
use DockerCli\Command\SeedCommand;
use DockerCli\Command\DownCommand;
use DockerCli\Command\StartCommand;
use DockerCli\Command\StopCommand;
use DockerCli\Command\SourceBuildCommand;
use DockerCli\Command\SourcePublishCommand;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$application = new Application('docker-cli', '0.1.0');
$application->add(new InitCommand());
$application->add(new UpCommand());
$application->add(new SeedCommand());
$application->add(new StartCommand());
$application->add(new StopCommand());
$application->add(new DownCommand());
$application->add(new SourceBuildCommand());
$application->add(new SourcePublishCommand());
$application->setDefaultCommand('list');
$application->run();
