{
    "name": "kubehut/docker-cli",
    "description": "Console application for managing local Docker environments.",
    "license": "Apache-2.0",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-zip": "*",
        "symfony/console": "^7.3",
        "symfony/yaml": "^7.3",
        "symfony/translation": "^7.3",
        "nubs/random-name-generator": "^2.2",
        "react/http": "^1.11",
        "nikic/fast-route": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "DockerCli\\": "src/"
        },
        "files": [
            "src/Util/functions.php"
        ]
    },
    "bin": [
        "bin/docker-cli"
    ],
    "scripts": {
        "build-panel": [
            "npm --prefix resources/panel ci",
            "npm --prefix resources/panel run build"
        ],
        "build-phar": "php -d phar.readonly=0 scripts/build-phar.php",
        "build": [
            "@build-panel",
            "@build-phar"
        ],
        "lint": "find bin scripts src tests -type f -name \"*.php\" -print0 | xargs -0 -n1 php -l",
        "test": "phpunit --colors=always",
        "quality": [
            "@lint",
            "@style",
            "@test"
        ],
        "style": "php-cs-fixer fix --dry-run --diff && php scripts/check-line-length.php",
        "fix": "php-cs-fixer fix && php scripts/check-line-length.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "^3.89"
    },
    "autoload-dev": {
        "psr-4": {
            "DockerCli\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
