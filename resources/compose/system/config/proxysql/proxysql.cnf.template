datadir="/var/lib/proxysql"

admin_variables =
{
    admin_credentials="admin:__PROXYSQL_ADMIN_PASSWORD__;__PROXYSQL_ADMIN_USER__:__PROXYSQL_ADMIN_PASSWORD__"
    stats_credentials="__PROXYSQL_WEB_USER__:__PROXYSQL_WEB_PASSWORD__"
    mysql_ifaces="0.0.0.0:6032"
    restapi_enabled=true
    web_enabled=true
    web_port=6080
}

mysql_variables =
{
    interfaces="0.0.0.0:6033"
    monitor_enabled=false
}

pgsql_variables =
{
    interfaces="0.0.0.0:6133"
    monitor_enabled=false
}

mysql_servers =
(
    {
        address="mysql"
        port=3306
        hostgroup=0
    }
)

pgsql_servers =
(
    {
        address="postgres"
        port=5432
        hostgroup=0
    }
)
